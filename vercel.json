{
  "version": 2,
  "redirects": [
    {
      "source": "/",
      "destination": "/demo.html",
      "permanent": false
    }
  ],
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.feishu.cn https://*.larksuite.com https://*.feishuapp.cn https://*.feishuapp.com"
        }
      ]
    }
  ]
}
