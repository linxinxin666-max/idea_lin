<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>idea creator - 抖音生活服务素材神器</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #0a1628 0%, #1a2d4a 50%, #0f1e33 100%);
            min-height: 100vh;
            color: #ffffff;
            overflow-x: hidden;
            -webkit-text-size-adjust: 100%;
            -webkit-tap-highlight-color: transparent;
        }
        
        body::-webkit-scrollbar,
        .sidebar::-webkit-scrollbar,
        .main-content::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        
        body::-webkit-scrollbar-track,
        .sidebar::-webkit-scrollbar-track,
        .main-content::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.35);
        }
        
        body::-webkit-scrollbar-thumb,
        .sidebar::-webkit-scrollbar-thumb,
        .main-content::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, 0.4);
            border-radius: 8px;
            border: 2px solid rgba(15, 23, 42, 0.4);
        }
        
        body::-webkit-scrollbar-thumb:hover,
        .sidebar::-webkit-scrollbar-thumb:hover,
        .main-content::-webkit-scrollbar-thumb:hover {
            background: rgba(148, 163, 184, 0.6);
        }
        
        .app {
            display: flex;
            min-height: 100vh;
        }
        
        /* 左边侧边栏 */
        .sidebar {
            width: 380px;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            border-right: 1px solid rgba(255, 255, 255, 0.1);
            padding: 32px 24px;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
            flex-shrink: 0;
        }
        
        /* 数据统计卡片 */
        .stats-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 24px;
        }
        
        .stats-title {
            font-size: 14px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.6);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }
        
        .stat-item {
            text-align: center;
            padding: 12px 8px;
            background: rgba(255, 255, 255, 0.02);
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .stat-number {
            font-size: 28px;
            font-weight: 800;
            background: linear-gradient(135deg, #667eea 0%, #f093fb 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 4px;
        }
        
        .stat-label {
            font-size: 12px;
            color: rgba(255, 255, 255, 0.6);
        }
        
        
        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 40px;
        }
        
        .logo-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: radial-gradient(circle at 30% 30%, #60a5fa 0%, #1d4ed8 55%, #0ea5e9 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            box-shadow: 0 10px 24px rgba(59, 130, 246, 0.35);
        }
        
        .logo h1 {
            font-size: 24px;
            font-weight: 800;
            background: linear-gradient(135deg, #93c5fd 0%, #1d4ed8 60%, #22d3ee 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        /* 日期卡片 */
        .date-card {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(99, 102, 241, 0.15) 100%);
            border: 1px solid rgba(59, 130, 246, 0.2);
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 24px;
        }
        
        .date-main {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 16px;
        }
        
        .date-number {
            font-size: 56px;
            font-weight: 800;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .date-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        
        .date-month-year {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.6);
        }
        
        .date-weekday {
            font-size: 18px;
            font-weight: 600;
            color: #ffffff;
        }
        
        .bigday-badge {
            display: none;
            align-self: flex-start;
            margin-top: 6px;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            color: #ffffff;
            background: linear-gradient(135deg, #f97316 0%, #ef4444 60%, #f59e0b 100%);
            box-shadow: 0 8px 18px rgba(239, 68, 68, 0.35);
        }
        
        /* 天气卡片 */
        .weather-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 24px;
        }
        
        .weather-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }
        
        .weather-icon {
            font-size: 32px;
        }
        
        .weather-text {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.8);
        }
        
        .weather-details {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        
        .weather-location {
            font-size: 12px;
            color: rgba(255, 255, 255, 0.6);
        }
        
        .weather-alert {
            margin-top: 10px;
            padding: 8px 10px;
            border-radius: 10px;
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #fca5a5;
            font-size: 12px;
            line-height: 1.4;
            display: none;
        }
        
        /* 加油语卡片 */
        .motivation-card {
            background: linear-gradient(135deg, rgba(249, 115, 22, 0.15) 0%, rgba(245, 158, 11, 0.15) 100%);
            border: 1px solid rgba(249, 115, 22, 0.2);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 24px;
        }
        
        .motivation-text {
            font-size: 15px;
            line-height: 1.8;
            color: rgba(255, 255, 255, 0.9);
            font-style: italic;
        }
        
        /* 节假日倒计时 */
        .countdown-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 20px;
        }
        
        .countdown-title {
            font-size: 14px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.6);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .countdown-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }
        
        .countdown-item:last-child {
            border-bottom: none;
        }
        
        .countdown-name {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.9);
        }
        
        .countdown-days {
            display: flex;
            align-items: baseline;
            gap: 4px;
        }
        
        .countdown-number {
            font-size: 24px;
            font-weight: 800;
            color: #f59e0b;
        }
        
        .countdown-unit {
            font-size: 12px;
            color: rgba(255, 255, 255, 0.6);
        }
        
        /* 主内容区 */
        .main-content {
            flex: 1;
            padding: 32px;
            overflow-y: auto;
        }
        
        /* Tab切换 */
        .tabs-container {
            display: flex;
            justify-content: flex-start;
            gap: 20px;
            margin-bottom: 32px;
            padding-bottom: 16px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .tab-btn {
            padding: 18px 48px;
            font-size: 18px;
            font-weight: 600;
            border-radius: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid transparent;
            background: rgba(255, 255, 255, 0.05);
            color: rgba(255, 255, 255, 0.7);
        }
        
        .tab-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #ffffff;
        }
        
        .tab-btn.active {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            border-color: rgba(59, 130, 246, 0.3);
            color: #ffffff;
            box-shadow: 0 10px 30px rgba(59, 130, 246, 0.3);
        }
        
        /* 专区内容 */
        .tab-content {
            display: none;
        }
        
        .tab-content.active {
            display: block;
        }
        
        /* 官方发布专区 - 优先版块 */
        .priority-section {
            margin-bottom: 48px;
        }
        
        .priority-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
            padding: 16px 24px;
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(249, 115, 22, 0.05) 100%);
            border-radius: 16px;
            border: 1px solid rgba(239, 68, 68, 0.2);
        }
        
        .priority-icon {
            font-size: 28px;
        }
        
        .priority-title {
            font-size: 20px;
            font-weight: 700;
            color: #ef4444;
        }
        
        .priority-badge {
            background: #ef4444;
            color: white;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
            margin-left: auto;
        }
        
        /* 历史版块 */
        .history-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
            padding: 16px 24px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .history-icon {
            font-size: 28px;
        }
        
        .history-title {
            font-size: 20px;
            font-weight: 700;
            color: rgba(255, 255, 255, 0.8);
        }
        
        /* 素材网格布局 */
        .materials-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
            gap: 20px;
        }
        
        /* 历史发布横向滚动 */
        .history-scroll-container {
            overflow-x: auto;
            padding: 8px 4px;
        }
        
        .history-scroll-container::-webkit-scrollbar {
            height: 8px;
        }
        
        .history-scroll-container::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
        }
        
        .history-scroll-container::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }
        
        .history-scroll-container::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.3);
        }
        
        .history-materials-horizontal {
            display: flex;
            gap: 20px;
            padding-bottom: 8px;
        }
        
        .history-materials-horizontal .material-card {
            flex-shrink: 0;
            width: 380px;
        }
        
        /* 素材卡片 */
        .material-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 24px;
            transition: all 0.3s ease;
        }
        
        .material-card.priority {
            border-color: rgba(239, 68, 68, 0.4);
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.08) 0%, rgba(255, 255, 255, 0.03) 100%);
        }
        
        .material-card.history {
            opacity: 0.8;
        }
        
        .material-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 16px;
            flex-wrap: wrap;
            gap: 10px;
        }
        
        .material-date {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.2) 0%, rgba(220, 38, 38, 0.2) 100%);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 16px;
            font-size: 13px;
            font-weight: 600;
            color: #ef4444;
        }
        
        .history .material-date {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.2);
            color: rgba(255, 255, 255, 0.7);
        }
        
        .material-actions {
            display: flex;
            gap: 8px;
        }
        
        .action-btn {
            padding: 8px 14px;
            font-size: 13px;
            font-weight: 600;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 6px;
            border: none;
        }
        
        .copy-btn {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            color: white;
            box-shadow: 0 10px 30px rgba(59, 130, 246, 0.3);
        }
        
        .copy-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 40px rgba(59, 130, 246, 0.4);
        }
        
        .download-btn {
            background: rgba(255, 255, 255, 0.05);
            color: white;
            border: 2px solid rgba(255, 255, 255, 0.2);
        }
        
        .download-btn:hover {
            border-color: rgba(59, 130, 246, 0.4);
            background: rgba(59, 130, 246, 0.1);
        }
        
        .material-text {
            font-size: 14px;
            line-height: 1.8;
            color: rgba(255, 255, 255, 0.95);
            white-space: pre-wrap;
            margin-bottom: 16px;
        }
        
        .material-images {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 10px;
        }
        
        .material-image {
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(0, 0, 0, 0.2);
        }
        
        .material-image img {
            width: 100%;
            height: auto;
            display: block;
        }
        
        /* BD自定义发布区域 - 优化版 */
        .bd-section {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
            padding: 36px;
        }
        
        .bd-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 32px;
            padding-bottom: 24px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .bd-header-icon {
            font-size: 32px;
        }
        
        .bd-header-title {
            font-size: 24px;
            font-weight: 700;
            color: #ffffff;
        }
        
        .bd-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 24px;
            margin-bottom: 32px;
        }
        
        .selector-group {
            background: rgba(255, 255, 255, 0.02);
            border-radius: 20px;
            padding: 20px 24px;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        
        .selector-title {
            font-size: 14px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.6);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .selector-title-icon {
            font-size: 16px;
        }
        
        .card-grid {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        
        .select-card {
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 12px 18px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 10px;
            flex: 0 0 auto;
        }
        
        .select-card:hover {
            border-color: rgba(102, 126, 234, 0.5);
            transform: translateY(-2px);
        }
        
        .select-card.selected {
            border-color: #3b82f6;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.18) 0%, rgba(29, 78, 216, 0.18) 100%);
        }
        
        .select-icon {
            font-size: 24px;
        }
        
        .select-name {
            font-size: 14px;
            font-weight: 600;
            color: #ffffff;
        }
        
        .select-desc {
            display: none;
        }
        
        /* 朋友圈预览区 - 企微样式 */
        .preview-section {
            background: #f3f4f6;
            border-radius: 20px;
            padding: 24px;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        
        .preview-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }
        
        .preview-title {
            font-size: 16px;
            font-weight: 600;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .preview-actions {
            display: flex;
            gap: 12px;
        }
        
        .regenerate-btn {
            padding: 10px 20px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.05);
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        
        .regenerate-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(102, 126, 234, 0.5);
            transform: translateY(-2px);
        }
        
        .copy-final-btn {
            padding: 10px 24px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            color: white;
            box-shadow: 0 10px 30px rgba(59, 130, 246, 0.3);
            display: flex;
            align-items: center;
            gap: 6px;
        }
        
        .copy-final-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 40px rgba(59, 130, 246, 0.4);
        }
        
        .copy-search-btn {
            padding: 10px 24px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            box-shadow: 0 10px 30px rgba(16, 185, 129, 0.3);
            display: flex;
            align-items: center;
            gap: 6px;
        }
        
        .copy-search-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 40px rgba(16, 185, 129, 0.4);
        }
        
        .wecom-moments {
            background: #ffffff;
            border-radius: 12px;
            padding: 16px;
            max-width: 600px;
            margin: 0 auto;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            border: 1px solid #e5e7eb;
        }
        
        .moments-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 10px;
        }
        
        .moments-header-left {
            display: flex;
            gap: 12px;
        }
        
        .moments-avatar {
            width: 42px;
            height: 42px;
            border-radius: 4px;
            background: linear-gradient(135deg, #3b82f6, #06b6d4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }
        
        .moments-user-info {
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
        }
        
        .moments-user-name {
            font-size: 15px;
            font-weight: 600;
            color: #576b95;
            margin-bottom: 6px;
        }
        
        .moments-time {
            font-size: 12px;
            color: #9ca3af;
        }
        
        .moments-content {
            font-size: 15px;
            line-height: 1.6;
            color: #111827;
            margin-bottom: 12px;
            white-space: pre-wrap;
        }
        
        .moments-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 6px;
        }
        
        .moments-footer-left {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .moments-stats {
            font-size: 12px;
            color: #9ca3af;
        }
        
        .moments-more {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            background: #f3f4f6;
            color: #6b7280;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            cursor: pointer;
        }
        
        .moments-action-btn {
            width: 32px;
            height: 22px;
            border-radius: 6px;
            background: #111827;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            cursor: pointer;
            letter-spacing: 2px;
        }
        
        /* Toast */
        .toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(20px);
            color: #ffffff;
            padding: 16px 32px;
            border-radius: 16px;
            font-size: 15px;
            font-weight: 500;
            z-index: 3000;
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .toast.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }
        
        /* 平板设备适配 (小于1024px) */
        @media (max-width: 1024px) {
            body {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }
            .app {
                min-width: 1200px;
            }
            .main-content {
                padding: 24px 20px;
            }
            .tabs-container {
                gap: 16px;
            }
            .tab-btn {
                padding: 16px 32px;
                font-size: 16px;
            }
        }
        
        /* 移动端适配 (小于768px) */
        @media (max-width: 768px) {
            body {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }
            .app {
                min-width: 1200px;
            }
            .sidebar {
                padding: 24px 20px;
            }
            .logo {
                margin-bottom: 32px;
            }
            .logo-icon {
                width: 40px;
                height: 40px;
                font-size: 20px;
            }
            .logo h1 {
                font-size: 22px;
            }
            .date-card, .weather-card, .motivation-card, .countdown-card, .stats-card {
                padding: 20px;
                margin-bottom: 20px;
                border-radius: 20px;
            }
            .date-number {
                font-size: 48px;
            }
            .date-weekday {
                font-size: 17px;
            }
            .main-content {
                padding: 24px 20px;
            }
            .tabs-container {
                gap: 12px;
                margin-bottom: 24px;
                padding-bottom: 14px;
            }
            .tab-btn {
                padding: 14px 28px;
                font-size: 15px;
                border-radius: 14px;
            }
            .priority-header, .history-header {
                padding: 14px 20px;
                border-radius: 16px;
                margin-bottom: 20px;
            }
            .materials-grid {
                grid-template-columns: 1fr;
                gap: 16px;
            }
            .material-card {
                padding: 20px;
                border-radius: 20px;
            }
            .bd-section {
                padding: 24px 20px;
                border-radius: 24px;
            }
            .card-grid {
                flex-direction: row;
                flex-wrap: wrap;
            }
            .select-card {
                flex: 1 1 45%;
                padding: 14px 16px;
                min-width: 150px;
            }
            .preview-section {
                padding: 20px;
                border-radius: 20px;
            }
            .wecom-moments {
                max-width: 100%;
            }
            .toast {
                bottom: 24px;
                padding: 14px 28px;
                font-size: 14px;
            }
        }
        
        /* 小屏移动端适配 (小于480px) */
        @media (max-width: 480px) {
            body {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }
            .app {
                min-width: 1200px;
            }
            .sidebar {
                padding: 20px 16px;
            }
            .logo {
                margin-bottom: 28px;
            }
            .logo-icon {
                width: 36px;
                height: 36px;
                font-size: 18px;
            }
            .logo h1 {
                font-size: 20px;
            }
            .date-card, .weather-card, .motivation-card, .countdown-card, .stats-card {
                padding: 16px;
                margin-bottom: 16px;
            }
            .stat-number {
                font-size: 26px;
            }
            .stat-label {
                font-size: 12px;
            }
            .tab-btn {
                padding: 12px 22px;
                font-size: 14px;
            }
            .select-card {
                flex: 1 1 100%;
            }
            .material-card {
                padding: 16px;
            }
        }
    </style>
</head>
<body>
    <div class="app">
        <!-- 左边侧边栏 -->
        <aside class="sidebar">
            <div class="logo">
                <span class="logo-icon">🎯</span>
                <h1>idea creator</h1>
            </div>
            
            <!-- 日期卡片 -->
            <div class="date-card">
                <div class="date-main">
                    <div class="date-number" id="dateNumber">28</div>
                    <div class="date-info">
                        <div class="date-month-year" id="dateMonthYear">2026年4月</div>
                        <div class="date-weekday" id="dateWeekday">星期二</div>
                        <div class="bigday-badge" id="bigDayBadge">BIG DAY</div>
                    </div>
                </div>
            </div>
            
            <!-- 天气卡片 -->
            <div class="weather-card">
                <div class="weather-header">
                    <span class="weather-icon">☀️</span>
                    <div class="weather-details">
                        <div class="weather-text" id="weatherText">正在获取天气</div>
                        <div class="weather-location" id="weatherLocation">定位中</div>
                    </div>
                </div>
                <div class="weather-alert" id="weatherAlert"></div>
            </div>
            
            <!-- 加油语卡片 -->
            <div class="motivation-card">
                <div class="motivation-text" id="motivationText">
                    每一份努力都不会白费，每一份坚持都会让你更接近成功！今天也要加油哦！💪
                </div>
            </div>
            
            <!-- 节假日倒计时 -->
            <div class="countdown-card">
                <div class="countdown-title">
                    <span>⏰</span>
                    节假日倒计时
                </div>
                <div id="countdownList">
                </div>
            </div>
            
            <div class="stats-card">
                <div class="stats-title">
                    <span>📊</span>
                    发布统计
                </div>
                <div class="stats-grid">
                    <div class="stat-item">
                        <div class="stat-number" id="todayCount">0</div>
                        <div class="stat-label">今日发布</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number" id="weekCount">0</div>
                        <div class="stat-label">本周发布</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number" id="monthCount">0</div>
                        <div class="stat-label">本月发布</div>
                    </div>
                </div>
            </div>
        </aside>
        
        <!-- 主内容区 -->
        <main class="main-content">
            <!-- Tab切换 -->
            <div class="tabs-container">
                <button class="tab-btn active" onclick="switchTab('official')">
                    📢 官方发布专区
                </button>
                <button class="tab-btn" onclick="switchTab('custom')">
                    ✨ 自定义发布专区
                </button>
            </div>
            
            <!-- 官方发布专区内容 -->
            <div id="official-tab" class="tab-content active">
                <!-- 优先发布版块 -->
                <div class="priority-section">
                    <div class="priority-header">
                        <span class="priority-icon">⭐</span>
                        <h2 class="priority-title">优先发布</h2>
                        <span class="priority-badge">今日及之后</span>
                    </div>
                    <div class="materials-grid" id="priorityMaterials">
                    </div>
                </div>
                
                <!-- 历史发布版块 -->
                <div class="history-section">
                    <div class="history-header">
                        <span class="history-icon">📜</span>
                        <h2 class="history-title">历史发布</h2>
                    </div>
                    <div class="history-scroll-container">
                        <div class="history-materials-horizontal" id="historyMaterials">
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- 自定义发布专区内容 -->
            <div id="custom-tab" class="tab-content">
                <div class="bd-section">
                    <div class="bd-grid">
                        <div class="selector-group">
                            <div class="selector-title">
                                <span class="selector-title-icon">👤</span>
                                选择人设
                            </div>
                            <div class="card-grid" id="personaGrid">
                                <div class="select-card selected" data-persona="professional">
                                    <span class="select-icon">👨‍💼</span>
                                    <span class="select-name">专业顾问</span>
                                </div>
                                <div class="select-card" data-persona="friendly">
                                    <span class="select-icon">🤝</span>
                                    <span class="select-name">亲切伙伴</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="selector-group">
                            <div class="selector-title">
                                <span class="selector-title-icon">📝</span>
                                选择内容类型
                            </div>
                            <div class="card-grid" id="contentTypeGrid">
                                <div class="select-card selected" data-type="business">
                                    <span class="select-icon">💡</span>
                                    <span class="select-name">经营技巧</span>
                                </div>
                                <div class="select-card" data-type="platform">
                                    <span class="select-icon">📱</span>
                                    <span class="select-name">平台动态</span>
                                </div>
                                <div class="select-card" data-type="holiday">
                                    <span class="select-icon">🎊</span>
                                    <span class="select-name">节日问候</span>
                                </div>
                                <div class="select-card" data-type="live">
                                    <span class="select-icon">🎥</span>
                                    <span class="select-name">直播动态</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- 朋友圈预览 -->
                    <div class="preview-section">
                        <div class="preview-header">
                            <div class="preview-title">
                                📱 微信朋友圈预览
                            </div>
                            <div class="preview-actions">
                                <button class="regenerate-btn" id="regenerateBtn">
                                    🔄 重新生成
                                </button>
                                <button class="copy-search-btn" id="copySearchBtn">
                                    🔍 复制搜索词
                                </button>
                                <button class="copy-final-btn" id="bdCopyBtn">
                                    📋 复制并跳转企微
                                </button>
                            </div>
                        </div>
                        
                        <!-- 企微朋友圈样式 -->
                        <div class="wecom-moments">
                            <div class="moments-header">
                                <div class="moments-header-left">
                                    <div class="moments-avatar">🎯</div>
                                    <div class="moments-user-info">
                                        <div class="moments-user-name">idea creator</div>
                                    </div>
                                </div>
                                <div class="moments-more">···</div>
                            </div>
                            <div class="moments-content" id="momentsContent">
                            </div>
                            <div class="moments-footer">
                                <div class="moments-footer-left">
                                    <span class="moments-time" id="momentsTime">刚刚</span>
                                </div>
                                <div class="moments-action-btn">···</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
    
