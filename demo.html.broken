        // 加油语库
        const motivations = [
            "每一份努力都不会白费，每一份坚持都会让你更接近成功！今天也要加油哦！💪",
            "成功的路上没有捷径，只有一步一个脚印的坚持！加油！🚀",
            "相信自己，你比想象中更强大！今天又是充满希望的一天！✨",
            "不要等待机会，而要创造机会！今天的努力是明天的收获！💫",
            "每一个不曾起舞的日子，都是对生命的辜负！今天也要元气满满！🌈"
        ];
        
        // 天气库
        const weathers = [
            { icon: "☀️", text: "晴 22°C" },
            { icon: "⛅", text: "多云 20°C" },
            { icon: "🌤️", text: "晴间多云 24°C" },
            { icon: "🌥️", text: "阴 18°C" },
            { icon: "🌞", text: "晴 25°C" }
        ];
        
        const weatherCodeMap = {
            0: { text: "晴", icon: "☀️" },
            1: { text: "晴间多云", icon: "🌤️" },
            2: { text: "多云", icon: "⛅" },
            3: { text: "阴", icon: "☁️" },
            45: { text: "雾", icon: "🌫️" },
            48: { text: "雾霾", icon: "🌫️" },
            51: { text: "小毛毛雨", icon: "🌦️" },
            53: { text: "毛毛雨", icon: "🌦️" },
            55: { text: "中雨", icon: "🌧️" },
            61: { text: "小雨", icon: "🌧️" },
            63: { text: "中雨", icon: "🌧️" },
            65: { text: "大雨", icon: "🌧️" },
            71: { text: "小雪", icon: "🌨️" },
            73: { text: "中雪", icon: "🌨️" },
            75: { text: "大雪", icon: "❄️" },
            80: { text: "阵雨", icon: "🌦️" },
            81: { text: "强阵雨", icon: "🌦️" },
            82: { text: "暴雨", icon: "⛈️" },
            95: { text: "雷暴", icon: "⛈️" },
            96: { text: "强雷暴", icon: "⛈️" },
            99: { text: "强雷暴", icon: "⛈️" }
        };
        
        function setWeatherDisplay({ icon, text, temperature, location, alert }) {
            const weatherText = temperature !== undefined ? `${text} ${Math.round(temperature)}°C` : text;
            const iconEl = document.querySelector('.weather-icon');
            if (iconEl) {
                iconEl.textContent = icon;
            }
            document.getElementById('weatherText').textContent = weatherText;
            document.getElementById('weatherLocation').textContent = location || '定位失败';
            const alertEl = document.getElementById('weatherAlert');
            if (alert) {
                alertEl.textContent = alert;
                alertEl.style.display = 'block';
            } else {
                alertEl.style.display = 'none';
            }
        }
        
        function getFallbackWeather() {
            const weather = weathers[Math.floor(Math.random() * weathers.length)];
            return { icon: weather.icon, text: weather.text, location: '正在定位' };
        }

        function getAmapKey() {
            return localStorage.getItem('AMAP_KEY') || '';
        }

        function formatLocation(province, city, district) {
            const cleanCity = Array.isArray(city) ? city[0] : city;
            const cityName = cleanCity && cleanCity !== province ? cleanCity : '';
            return [province, cityName, district].filter(Boolean).join('');
        }

        function getWeatherIconByText(text) {
            if (!text) return '🌤️';
            if (text.includes('雷')) return '⛈️';
            if (text.includes('雪')) return '🌨️';
            if (text.includes('雨')) return '🌧️';
            if (text.includes('雾')) return '🌫️';
            if (text.includes('阴')) return '☁️';
            if (text.includes('云')) return '⛅';
            return '☀️';
        }
        
        async function getGeoLocation() {
            if (navigator.geolocation) {
                try {
                    const position = await new Promise((resolve, reject) => {
                        navigator.geolocation.getCurrentPosition(resolve, reject, { timeout: 5000 });
                    });
                    return { lat: position.coords.latitude, lon: position.coords.longitude };
                } catch (e) {
                }
            }
            try {
                const ipRes = await fetch('https://ipapi.co/json/');
                const ipData = await ipRes.json();
                if (ipData && ipData.latitude && ipData.longitude) {
                    return { lat: ipData.latitude, lon: ipData.longitude, city: ipData.city, region: ipData.region };
                }
            } catch (e) {
            }
            return null;
        }
        
        async function reverseGeocode(lat, lon) {
            const amapKey = getAmapKey();
            if (amapKey) {
                try {
                    const res = await fetch(`https://restapi.amap.com/v3/geocode/regeo?location=${lon},${lat}&key=${amapKey}&radius=1000&extensions=base`);
                    const data = await res.json();
                    const comp = data && data.regeocode && data.regeocode.addressComponent;
                    if (comp) {
                        const location = formatLocation(comp.province || '', comp.city || comp.province || '', comp.district || '');
                        if (location) return location;
                    }
                } catch (e) {
                }
            }
            try {
                const res = await fetch(`https://geocoding-api.open-meteo.com/v1/reverse?latitude=${lat}&longitude=${lon}&language=zh&format=json`);
                const data = await res.json();
                const place = data && data.results && data.results[0];
                if (place) {
                    const parts = [place.admin1 || '', place.admin2 || '', place.name || ''].filter(Boolean);
                    return parts.join('');
                }
            } catch (e) {
            }
            try {
                const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}&accept-language=zh-CN`);
                const data = await res.json();
                if (data && data.address) {
                    const city = data.address.city || data.address.town || data.address.village || data.address.county || '';
                    const state = data.address.state || data.address.region || '';
                    const district = data.address.suburb || data.address.neighbourhood || data.address.county || '';
                    const parts = [state, city, district].filter(Boolean);
                    if (parts.length > 0) {
                        return parts.join('');
                    }
                }
            } catch (e) {
            }
            return '';
        }

        async function getAmapIp(amapKey) {
            const res = await fetch(`https://restapi.amap.com/v3/ip?key=${amapKey}`);
            const data = await res.json();
            if (data && data.status === '1') {
                const province = data.province || '';
                const city = data.city || '';
                const adcode = data.adcode || '';
                const location = formatLocation(province, city, '');
                if (location && adcode) {
                    return { location, adcode };
                }
            }
            return null;
        }

        async function getAmapRegeo(lat, lon, amapKey) {
            const res = await fetch(`https://restapi.amap.com/v3/geocode/regeo?location=${lon},${lat}&key=${amapKey}&radius=1000&extensions=base`);
            const data = await res.json();
            const comp = data && data.regeocode && data.regeocode.addressComponent;
            if (comp) {
                const location = formatLocation(comp.province || '', comp.city || comp.province || '', comp.district || '');
                const adcode = comp.adcode || '';
                if (location && adcode) {
                    return { location, adcode };
                }
            }
            return null;
        }

        async function getAmapWeather(adcode, amapKey) {
            const res = await fetch(`https://restapi.amap.com/v3/weather/weatherInfo?city=${adcode}&key=${amapKey}&extensions=base`);
            const data = await res.json();
            const live = data && data.lives && data.lives[0];
            if (live) {
                const temp = parseFloat(live.temperature);
                return {
                    text: live.weather || '天气',
                    temperature: Number.isNaN(temp) ? undefined : temp,
                    alert: ''
                };
            }
            return null;
        }
        
        const bdState = {
            persona: "professional",
            type: "business",
            currentText: ""
        };
        
        // 发布统计相关
        let userId = localStorage.getItem('idea_creator_user_id');
        if (!userId) {
            userId = 'user_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
            localStorage.setItem('idea_creator_user_id', userId);
        }
        
        // 获取发布记录
        function getPublishRecords() {
            const records = localStorage.getItem('idea_creator_publish_records');
            return records ? JSON.parse(records) : {};
        }
        
        // 保存发布记录
        function savePublishRecords(records) {
            localStorage.setItem('idea_creator_publish_records', JSON.stringify(records));
        }
        
        // 记录发布（同一天同一文案只算一次）
        function recordPublish(text) {
            const records = getPublishRecords();
            const todayStr = today.toISOString().split('T')[0];
            const textHash = simpleHash(text);
            
            if (!records[userId]) {
                records[userId] = {};
            }
            if (!records[userId][todayStr]) {
                records[userId][todayStr] = [];
            }
            
            // 检查今天是否已经发布过这个文案
            if (!records[userId][todayStr].includes(textHash)) {
                records[userId][todayStr].push(textHash);
                savePublishRecords(records);
                updateStatsDisplay();
            }
        }
        
        // 简单的字符串哈希函数
        function simpleHash(str) {
            let hash = 0;
            for (let i = 0; i < str.length; i++) {
                const char = str.charCodeAt(i);
                hash = ((hash << 5) - hash) + char;
                hash = hash & hash;
            }
            return Math.abs(hash).toString(36);
        }
        
        // 更新统计显示
        function updateStatsDisplay() {
            const records = getPublishRecords();
            const userRecords = records[userId] || {};
            
            // 今日发布数
            const todayStr = today.toISOString().split('T')[0];
            const todayCount = userRecords[todayStr] ? userRecords[todayStr].length : 0;
            document.getElementById('todayCount').textContent = todayCount;
            
            // 本周发布数
            const weekStart = new Date(today);
            weekStart.setDate(today.getDate() - today.getDay());
            weekStart.setHours(0, 0, 0, 0);
            let weekCount = 0;
            for (let dateStr in userRecords) {
                const date = new Date(dateStr);
                if (date >= weekStart) {
                    weekCount += userRecords[dateStr].length;
                }
            }
            document.getElementById('weekCount').textContent = weekCount;
            
            // 本月发布数
            const monthStart = new Date(today.getFullYear(), today.getMonth(), 1);
            let monthCount = 0;
            for (let dateStr in userRecords) {
                const date = new Date(dateStr);
                if (date >= monthStart) {
                    monthCount += userRecords[dateStr].length;
                }
            }
            document.getElementById('monthCount').textContent = monthCount;
        }
        
        // Tab切换
        function switchTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
            });
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            
            document.getElementById(tabName + '-tab').classList.add('active');
            event.target.classList.add('active');
        }
        
        // 初始化日期
        function initDate() {
            const now = today;
            const dateNumber = document.getElementById('dateNumber');
            const dateMonthYear = document.getElementById('dateMonthYear');
            const dateWeekday = document.getElementById('dateWeekday');
            
            const weekdays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];
            const months = ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月'];
            
            dateNumber.textContent = now.getDate();
            dateMonthYear.textContent = `${now.getFullYear()}年${months[now.getMonth()]}`;
            dateWeekday.textContent = weekdays[now.getDay()];
        }
        
        // 初始化天气
        async function initWeather() {
            const fallback = getFallbackWeather();
            setWeatherDisplay({ ...fallback, temperature: undefined, alert: '' });
            const geo = await getGeoLocation();
            const amapKey = getAmapKey();
            if (amapKey) {
                try {
                    let amapLocation = null;
                    if (geo) {
                        amapLocation = await getAmapRegeo(geo.lat, geo.lon, amapKey);
                    }
                    if (!amapLocation) {
                        amapLocation = await getAmapIp(amapKey);
                    }
                    if (amapLocation) {
                        const weather = await getAmapWeather(amapLocation.adcode, amapKey);
                        if (weather) {
                            setWeatherDisplay({
                                icon: getWeatherIconByText(weather.text),
                                text: weather.text,
                                temperature: weather.temperature,
                                location: amapLocation.location || '定位失败',
                                alert: weather.alert || ''
                            });
                            return;
                        }
                    }
                } catch (e) {
                }
            }
            if (!geo) {
                return;
            }
            const lat = geo.lat;
            const lon = geo.lon;
            let locationName = await reverseGeocode(lat, lon);
            try {
                const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code&timezone=auto&alerts=1`);
                const data = await res.json();
                const current = data && data.current;
                if (current) {
                    const code = current.weather_code;
                    const mapped = weatherCodeMap[code] || { text: '天气', icon: '🌤️' };
                    const alertText = data.alerts && data.alerts.length > 0 ? data.alerts[0].event || data.alerts[0].headline : '';
                    setWeatherDisplay({
                        icon: mapped.icon,
                        text: mapped.text,
                        temperature: current.temperature_2m,
                        location: locationName || '定位失败',
                        alert: alertText || ''
                    });
                }
            } catch (e) {
            }
        }
        
        // 初始化加油语
        function initMotivation() {
            const motivation = motivations[Math.floor(Math.random() * motivations.length)];
            document.getElementById('motivationText').textContent = motivation;
        }
        
        function getHolidays(year) {
            return [
                { name: '五一劳动节', date: new Date(year, 4, 1) },
                { name: '端午节', date: new Date(year, 5, 10) },
                { name: '中秋节', date: new Date(year, 8, 17) },
                { name: '国庆节', date: new Date(year, 9, 1) }
            ];
        }
        
        function updateBigDay() {
            const badgeEl = document.getElementById('bigDayBadge');
            const reasons = [];
            if (today.getDay() === 5) {
                reasons.push('每周五冲刺日');
            }
            const holidays = getHolidays(today.getFullYear());
            const tomorrow = new Date(today);
            tomorrow.setDate(today.getDate() + 1);
            holidays.forEach(holiday => {
                if (holiday.date.toDateString() === tomorrow.toDateString()) {
                    reasons.push(`${holiday.name}前一天`);
                }
            });
            if (reasons.length > 0) {
                badgeEl.textContent = 'BIG DAY';
                badgeEl.style.display = 'inline-flex';
            } else {
                badgeEl.style.display = 'none';
            }
        }
        
        // 初始化倒计时
        function initCountdown() {
            const now = today;
            const holidays = getHolidays(now.getFullYear());
            
            const countdownList = document.getElementById('countdownList');
            let html = '';
            
            holidays.forEach(holiday => {
                const target = holiday.date;
                const diff = Math.ceil((target - now) / (1000 * 60 * 60 * 24));
                
                if (diff > 0) {
                    html += `
                        <div class="countdown-item">
                            <div class="countdown-name">${holiday.name}</div>
                            <div class="countdown-days">
                                <span class="countdown-number">${diff}</span>
                                <span class="countdown-unit">天</span>
                            </div>
                        </div>
                    `;
                }
            });
            
            countdownList.innerHTML = html;
        }
        
        // 解析日期
        function parseDate(dateStr) {
            try {
                const parts = dateStr.split('.');
                const month = parseInt(parts[0]) - 1;
                const day = parseInt(parts[1]);
                return new Date(2026, month, day);
            } catch {
                return null;
            }
        }
        
        // 渲染官方素材
        function renderOfficialMaterials() {
            const priorityContainer = document.getElementById('priorityMaterials');
            const historyContainer = document.getElementById('historyMaterials');
            
            let priorityHtml = '';
            let historyHtml = '';
            
            allMaterials.forEach((material, index) => {
                const materialDate = parseDate(material.date);
                const isPriority = materialDate && materialDate >= today;
                
                const html = `
                    <div class="material-card ${isPriority ? 'priority' : 'history'}">
                        <div class="material-header">
                            <div class="material-date">📅 ${material.date}</div>
                            <div class="material-actions">
                                <button class="action-btn copy-btn" onclick="copyOfficialText(${index})">
                                    <span>📋</span> 复制
                                </button>
                                ${material.images.length > 0 ? `
                                    <button class="action-btn download-btn" onclick="downloadOfficialImages(${index})">
                                        <span>⬇️</span> 下载
                                    </button>
                                ` : ''}
                            </div>
                        </div>
                        <div class="material-text">${material.text}</div>
                        ${material.images.length > 0 ? `
                            <div class="material-images">
                                ${material.images.map(img => `
                                    <div class="material-image">
                                        <img src="${img}" alt="素材图片" onerror="this.parentElement.style.display='none'">
                                    </div>
                                `).join('')}
                            </div>
                        ` : ''}
                    </div>
                `;
                
                if (isPriority) {
                    priorityHtml += html;
                } else {
                    historyHtml += html;
                }
            });
            
            priorityContainer.innerHTML = priorityHtml;
            historyContainer.innerHTML = historyHtml;
        }
        
        // 复制文案
        async function copyText(text) {
            try {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(text);
                    showToast('已复制');
                } else {
                    const textArea = document.createElement('textarea');
                    textArea.value = text;
                    textArea.style.position = 'fixed';
                    textArea.style.left = '-9999px';
                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();
                    document.execCommand('copy');
                    document.body.removeChild(textArea);
                    showToast('已复制');
                }
                
                // 记录发布
                recordPublish(text);
                
                setTimeout(() => {
                    window.location.href = 'wework://';
                }, 300);
            } catch (e) {
                showToast('复制失败，请手动复制');
            }
        }
        
        async function copyOfficialText(index) {
            copyText(allMaterials[index].text);
        }
        
        // 下载图片
        function saveImageToPhone(imgSrc, filename) {
            try {
                const link = document.createElement('a');
                link.href = imgSrc;
                link.download = filename;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            } catch (e) {
                showToast('下载失败，请尝试长按图片保存');
            }
        }
        
        function downloadOfficialImages(index) {
            const material = allMaterials[index];
            if (material.images.length === 0) {
                showToast('该素材没有图片');
                return;
            }
            
            material.images.forEach((imgSrc, i) => {
                saveImageToPhone(imgSrc, `官方素材_${material.date}_${i + 1}.jpeg`);
            });
            
            showToast(`${material.images.length}张图片开始下载！`);
        }
        
        // BD自定义发布
        function getBdContent() {
            const contents = contentLibrary[bdState.persona]?.[bdState.type] || contentLibrary.professional.business;
            return contents[Math.floor(Math.random() * contents.length)];
        }
        
        function updateBdPreview() {
            bdState.currentText = getBdContent();
            document.getElementById('momentsContent').textContent = bdState.currentText;
            
            // 更新搜索词按钮文字
            const copySearchBtn = document.getElementById('copySearchBtn');
            if (bdState.type === 'live') {
                copySearchBtn.textContent = '🔗 复制课程链接';
            } else {
                copySearchBtn.textContent = '🔍 复制搜索词';
            }
        }
        
        function extractSearchKeyword(text) {
            const match = text.match(/🔍 搜索词[：:]\s*(.*?(?=\s*\n|$))/);
            if (match) {
                return match[1].trim();
            }
            return text.split('\n')[0]?.replace(/^[🔥📊💼😊✨🎉]?【】?\s*|\s*】?$/g, '').trim();
        }
        
        function extractCourseLink(text) {
            const match = text.match(/🔗 (?:观看|学习|课程)链接[：:]\s*(.*?(?=\s*\n|$))/);
            if (match) {
                return match[1].trim();
            }
            return text.match(/https?:\/\/[^\s]+/)?.[0] || '';
        }
        
        function initBdSelectors() {
            document.querySelectorAll('#personaGrid .select-card').forEach(card => {
                card.addEventListener('click', () => {
                    document.querySelectorAll('#personaGrid .select-card').forEach(c => c.classList.remove('selected'));
                    card.classList.add('selected');
                    bdState.persona = card.dataset.persona;
                    updateBdPreview();
                });
            });
            
            document.querySelectorAll('#contentTypeGrid .select-card').forEach(card => {
                card.addEventListener('click', () => {
                    document.querySelectorAll('#contentTypeGrid .select-card').forEach(c => c.classList.remove('selected'));
                    card.classList.add('selected');
                    bdState.type = card.dataset.type;
                    updateBdPreview();
                });
            });
            
            document.getElementById('regenerateBtn').addEventListener('click', updateBdPreview);
            
            document.getElementById('copySearchBtn').addEventListener('click', () => {
                if (bdState.type === 'live') {
                    const link = extractCourseLink(bdState.currentText);
                    copyText(link);
                    showToast('课程链接已复制！');
                } else {
                    const keyword = extractSearchKeyword(bdState.currentText);
                    copyText(keyword);
                    showToast('搜索词已复制！');
                }
            });
            
            document.getElementById('bdCopyBtn').addEventListener('click', () => {
                copyText(bdState.currentText);
            });
        }
        
        function normalizeToastMessage(message) {
            if (message == null) return '';
            if (typeof message !== 'string') {
                if (typeof message === 'object' && message.message) return String(message.message);
                return String(message);
            }

            const s = message.trim();
            if (!s) return '';
            if (!(s.startsWith('{') || s.startsWith('['))) return message;

            try {
                const parsed = JSON.parse(s);
                if (parsed && typeof parsed === 'object' && ('traceId' in parsed || 'chatSessionId' in parsed)) {
                    const readable = parsed.message || parsed.msg || parsed.error || parsed.errorMessage;
                    if (readable) return String(readable);
                    if (parsed.traceId) return `请求失败，请稍后重试（traceId: ${String(parsed.traceId)}）`;
                    return '请求失败，请稍后重试';
                }
                return message;
            } catch {
                return message;
            }
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            toast.textContent = normalizeToastMessage(message);
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 2000);
        }
        
        // 初始化
        function init() {
            initDate();
            initWeather();
            initMotivation();
            initCountdown();
            updateBigDay();
            renderOfficialMaterials();
            initBdSelectors();
            updateBdPreview();
            updateStatsDisplay();
        }
        
        init();
    </script>
</body>
</html>
